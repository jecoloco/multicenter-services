{
  "memory": 256,
  "ttl": 10,
  "timeout": 10,
  "minReplicas": 2,
  "maxReplicas": 4,
  "workers": 1,
  "routes": {
    "status": {
      "path": "/_v/status/:code",
      "public": true
    },
    "authenticate": {
      "path": "/_v/private/authenticate",
      "method": "POST",
      "public": true
    },
    "pointvalue": {
      "path": "/_v/private/pointvalue",
      "method": "GET",
      "public": true
    },
    "customer": {
      "path": "/_v/private/customer",
      "method": "POST",
      "public": true
    },
    "authtoken": {
      "path": "/_v/private/authtoken",
      "method": "POST",
      "public": true
    },
    "paymentpreview": {
      "path": "/_v/private/paymentpreview",
      "method": "POST",
      "public": true
    },
    "customerotpvalidate": {
      "path": "/_v/private/customerotpvalidate",
      "method": "POST",
      "public": true
    },
    "paymentpreviewcustomer": {
      "path": "/_v/private/paymentpreviewcustomer",
      "method": "POST",
      "public": true
    },
    "paymentpreviewupdatecustomer": {
      "path": "/_v/private/paymentpreviewupdatecustomer",
      "method": "PATCH",
      "public": true
    },
    "paymentpreviewaccount": {
      "path": "/_v/private/paymentpreviewaccount",
      "method": "POST",
      "public": true
    }
  }
}
